# Trouble Ticket API: every endpoint, happy paths and contract errors.
#
# Run the whole file top to bottom ("Run All Requests in File"): later requests
# reuse the ticket id created by the first one.
# No environment needs to be selected: all variables are defined right below.
# Demo services (db/seed): 987654321 tenant-a active, 987654323 tenant-a INACTIVE,
# 123456789 tenant-b active.

# ---- Variables (in-file, used by every request) ---------------------------
# Tokens: signed with the local default JWT_SECRET, valid for 1 year. They only work
# against a local app using that publicly documented dev secret, so they hold no real secret.
# Regenerate (e.g. after changing JWT_SECRET in .env):
#   ./gradlew -q generateToken -PttlSeconds=31536000                     -> tokenA
#   ./gradlew -q generateToken -Ptenant=tenant-b -PttlSeconds=31536000   -> tokenB
#   ./gradlew -q generateToken -Ptenant= -PttlSeconds=31536000           -> tokenNoTenant
@baseUrl = http://localhost:8080/api/v1
@tokenA = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJsb2NhbC1yZXZpZXdlciIsInRlbmFudF9pZCI6InRlbmFudC1hIiwiaWF0IjoxNzkzNzMxMDc0LCJleHAiOjE4MjUyNjcwNzR9.4xuoK9M0DBSHCf9QyYsz_P6jv65FqgVGpHifqmggs9o
@tokenB = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJsb2NhbC1yZXZpZXdlciIsInRlbmFudF9pZCI6InRlbmFudC1iIiwiaWF0IjoxNzkzNzMxMDc0LCJleHAiOjE4MjUyNjcwNzR9.O6-xWdnLveWF_hbQJxTMdjZm_BLpAsbKuslph2wpv_4
@tokenNoTenant = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJsb2NhbC1yZXZpZXdlciIsInRlbmFudF9pZCI6IiIsImlhdCI6MTc5MzczMTA3NCwiZXhwIjoxODI1MjY3MDc0fQ.LVf5TmPFfVn8wgomDEwy1-hFZrYZKbo4x27abxySI-E

#######################################################################
# 1. CREATE  POST /troubleTicket
#######################################################################

### 1.1 Create ticket -> 201 Created + Location
POST {{baseUrl}}/troubleTicket
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
  "externalId": "OK-{{$uuid}}",
  "serviceId": 987654321,
  "description": "Brak transmisji danych dla usługi klienta.",
  "status": "new",
  "note": "Zgłoszenie utworzone przez konto API partnera."
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, "got " + response.status));
    client.test("Location points to the new ticket", () => {
        const location = response.headers.valueOf("Location");
        client.assert(location === "/api/v1/troubleTicket/" + response.body.id, "Location: " + location);
    });
    client.test("Full TroubleTicket representation", () => {
        const t = response.body;
        client.assert(t.id && t.externalId && t.serviceId === 987654321 && t.description, "missing fields");
        client.assert(t.status === "new" || t.status === "acknowledged", "status: " + t.status);
    });
    client.test("Initial note is notes[0]", () => {
        client.assert(response.body.notes.length === 1, "notes: " + response.body.notes.length);
        client.assert(response.body.notes[0].text === "Zgłoszenie utworzone przez konto API partnera.");
        client.assert(response.body.notes[0].id && response.body.notes[0].date, "note id/date missing");
    });
    client.global.set("ticketId", response.body.id);
    client.global.set("externalId", response.body.externalId);
%}

### 1.2 Same (tenant, externalId) again -> 200 OK, existing ticket unchanged
POST {{baseUrl}}/troubleTicket
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
  "externalId": "{{externalId}}",
  "serviceId": 987654322,
  "description": "A different description that must be ignored",
  "status": "new",
  "note": "A different note that must be ignored"
}

> {%
    client.test("200 OK (idempotent)", () => client.assert(response.status === 200, "got " + response.status));
    client.test("Same ticket returned", () => client.assert(response.body.id === client.global.get("ticketId")));
    client.test("Location header present", () => client.assert(response.headers.valueOf("Location")));
    client.test("Original data not overwritten", () => {
        client.assert(response.body.serviceId === 987654321, "serviceId changed");
        client.assert(response.body.notes.length === 1, "extra note added");
    });
%}

### 1.3 Status other than "new" -> 400 VALIDATION_ERROR
POST {{baseUrl}}/troubleTicket
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
  "externalId": "OK-{{$uuid}}",
  "serviceId": 987654321,
  "description": "d",
  "status": "closed",
  "note": "n"
}

> {%
    client.test("400 VALIDATION_ERROR", () => {
        client.assert(response.status === 400, "got " + response.status);
        client.assert(response.body.code === "VALIDATION_ERROR", "code: " + response.body.code);
        client.assert(response.body.message && response.body.requestId, "Error shape");
    });
%}

