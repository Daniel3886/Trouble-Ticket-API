#######################################################################
# 4. ADD NOTE  POST /troubleTicket/{id}/note
#######################################################################

### 4.1 Add note -> 201 with exactly that note
POST {{baseUrl}}/troubleTicket/{{ticketId}}/note
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
  "text": "Klient prosi o potwierdzenie planowanego terminu zamknięcia."
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, "got " + response.status));
    client.test("Returns the new Note", () => {
        client.assert(response.body.text === "Klient prosi o potwierdzenie planowanego terminu zamknięcia.");
        client.assert(response.body.id && response.body.date, "id/date missing");
    });
%}

### 4.2 Empty text -> 400 VALIDATION_ERROR
POST {{baseUrl}}/troubleTicket/{{ticketId}}/note
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
  "text": ""
}

> {%
    client.test("400 VALIDATION_ERROR", () => {
        client.assert(response.status === 400, "got " + response.status);
        client.assert(response.body.code === "VALIDATION_ERROR", "code: " + response.body.code);
    });
%}

### 4.3 Note on unknown ticket -> 404 TROUBLE_TICKET_NOT_FOUND
