#######################################################################
# 2. LIST  GET /troubleTicket
#######################################################################

### 2.1 List own tickets -> 200, summary fields only
GET {{baseUrl}}/troubleTicket
Authorization: Bearer {{tokenA}}

> {%
    client.test("200 OK, array", () => {
        client.assert(response.status === 200, "got " + response.status);
        client.assert(Array.isArray(response.body), "not an array");
    });
    client.test("Contains the created ticket", () => {
        client.assert(response.body.some(t => t.externalId === client.global.get("externalId")));
    });
    client.test("Only externalId, serviceId, description, status", () => {
        const keys = Object.keys(response.body[0]).sort().join(",");
        client.assert(keys === "description,externalId,serviceId,status", "keys: " + keys);
    });
%}

### 2.2 Other tenant does not see tenant-a tickets -> 200 without them
GET {{baseUrl}}/troubleTicket
Authorization: Bearer {{tokenB}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, "got " + response.status));
    client.test("tenant-a ticket not visible", () => {
        client.assert(!response.body.some(t => t.externalId === client.global.get("externalId")));
    });
%}

#######################################################################
# 3. GET ONE  GET /troubleTicket/{id}
#######################################################################

### 3.1 Get own ticket -> 200 full representation
GET {{baseUrl}}/troubleTicket/{{ticketId}}
Authorization: Bearer {{tokenA}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, "got " + response.status));
    client.test("Same ticket with notes", () => {
        client.assert(response.body.id === client.global.get("ticketId"));
        client.assert(Array.isArray(response.body.notes) && response.body.notes.length >= 1);
    });
%}

### 3.2 Unknown id -> 404 TROUBLE_TICKET_NOT_FOUND
GET {{baseUrl}}/troubleTicket/does-not-exist
Authorization: Bearer {{tokenA}}

> {%
    client.test("404 TROUBLE_TICKET_NOT_FOUND", () => {
        client.assert(response.status === 404, "got " + response.status);
        client.assert(response.body.code === "TROUBLE_TICKET_NOT_FOUND", "code: " + response.body.code);
    });
%}

### 3.3 Other tenant's ticket -> 404 (existence is not revealed)
GET {{baseUrl}}/troubleTicket/{{ticketId}}
Authorization: Bearer {{tokenB}}

> {%
    client.test("404 TROUBLE_TICKET_NOT_FOUND", () => {
