### 5.3 Other tenant closes tenant-a ticket -> 404 TROUBLE_TICKET_NOT_FOUND
PATCH {{baseUrl}}/troubleTicket/{{ticketId}}
Authorization: Bearer {{tokenB}}
Content-Type: application/json

{
  "status": "closed"
}

> {%
    client.test("404 TROUBLE_TICKET_NOT_FOUND", () => {
        client.assert(response.status === 404, "got " + response.status);
        client.assert(response.body.code === "TROUBLE_TICKET_NOT_FOUND", "code: " + response.body.code);
    });
%}

### 5.4 Close -> 200 with status "closed"
PATCH {{baseUrl}}/troubleTicket/{{ticketId}}
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
  "status": "closed"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, "got " + response.status));
    client.test("Status is closed, notes kept in order", () => {
        client.assert(response.body.status === "closed", "status: " + response.body.status);
        client.assert(response.body.notes.length === 2, "notes: " + response.body.notes.length);
        client.assert(response.body.notes[0].text === "Zgłoszenie utworzone przez konto API partnera.");
    });
%}

### 5.5 Close again -> 200 (assumption: closing is idempotent, see README)
PATCH {{baseUrl}}/troubleTicket/{{ticketId}}
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
  "status": "closed"
}

> {%
    client.test("200 OK, still closed", () => {
        client.assert(response.status === 200, "got " + response.status);
        client.assert(response.body.status === "closed");
    });
%}

### 5.6 Close unknown ticket -> 404 TROUBLE_TICKET_NOT_FOUND
PATCH {{baseUrl}}/troubleTicket/does-not-exist
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
  "status": "closed"
}

> {%
    client.test("404 TROUBLE_TICKET_NOT_FOUND", () => {
        client.assert(response.status === 404, "got " + response.status);
        client.assert(response.body.code === "TROUBLE_TICKET_NOT_FOUND", "code: " + response.body.code);
    });
%}

#######################################################################
# 6. AUTHENTICATION / AUTHORIZATION (any endpoint)
#######################################################################

### 6.1 No token -> 401 UNAUTHORIZED
GET {{baseUrl}}/troubleTicket

> {%
    client.test("401 UNAUTHORIZED", () => {
        client.assert(response.status === 401, "got " + response.status);
        client.assert(response.body.code === "UNAUTHORIZED", "code: " + response.body.code);
        client.assert(response.body.requestId === response.headers.valueOf("X-Request-ID"), "requestId != X-Request-ID");
    });
%}

### 6.2 Invalid (tampered) token -> 401 UNAUTHORIZED
GET {{baseUrl}}/troubleTicket
Authorization: Bearer {{tokenA}}tampered

> {%
    client.test("401 UNAUTHORIZED", () => {
        client.assert(response.status === 401, "got " + response.status);
        client.assert(response.body.code === "UNAUTHORIZED", "code: " + response.body.code);
    });
%}

### 6.3 Valid token without tenant_id -> 403
# Note: the app returns code MISSING_TENANT; the spec's Forbidden example uses FORBIDDEN.
GET {{baseUrl}}/troubleTicket
Authorization: Bearer {{tokenNoTenant}}

> {%
    client.test("403 Forbidden in Error format", () => {
        client.assert(response.status === 403, "got " + response.status);
        client.assert(response.body.code && response.body.message, "Error shape");
    });
%}
