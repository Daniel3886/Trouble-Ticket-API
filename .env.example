# Copy this file to .env and adjust the values.
#   cp .env.example .env

POSTGRES_DB=trouble_ticket
POSTGRES_USER=ticket_user
POSTGRES_PASSWORD=local_dev_password

# JDBC URL for running the app outside Docker (./gradlew bootRun / IDE).
# compose.yaml overrides this for the app container (host "postgres").
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/trouble_ticket

# HMAC (HS256) key used to verify JWTs. Must be at least 32 bytes.
JWT_SECRET=local-dev-secret-change-me-1234567890

# Flyway: schema + demo services (tenant-a, tenant-b) for local runs.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
